    <li><span class="swatch is-live" aria-hidden="true"></span>Live community</li>
    <li><span class="swatch is-waiting" aria-hidden="true"></span>People waiting</li>
    <li><span class="swatch" aria-hidden="true"></span>Federal data only</li>
  </ul>`;
  const liveRows = [];
  for (const fips of Object.keys(LIVE)) {
    const place2 = await loadPlace(env, request, stOfFips(fips).toLowerCase());
    const c = place2 && place2.counties.find((x) => x.fips === fips);
    if (c) liveRows.push(`<a class="list-row link-row" href="${placeHref(place2.st, c.slug)}"><div><div class="list-title">${esc(c.name)}, ${esc(place2.name)} <span class="live-tag">Live</span></div><div class="list-meta">Meetings, agendas, comment deadlines and the votes of every official who represents it</div></div><span class="row-end"><span class="chev" aria-hidden="true">\u203A</span></span></a>`);
  }
  const top = Object.entries(waiting.county).filter(([f]) => !LIVE[f]).sort((a, b) => b[1] - a[1]).slice(0, 8);
  const topRows = [];
