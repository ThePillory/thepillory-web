  if (!s) return { error: "No such report.", form: form2 };
  if (action === "reread") {
    if (!["disagree", "rejected"].includes(s.status)) return { error: "Only a report that didn't agree or was rejected can be read again.", form: form2 };
    await db.batch([
      db.prepare("UPDATE trade_scans SET status = 'pending', reading = NULL, problems = NULL, unread = NULL, rows_total = NULL, error = NULL, tries = 0, reviewed_by = NULL, reviewer_email = NULL, reviewed_at = NULL, reject_reason = NULL WHERE report_id = ?").bind(id),
      db.prepare("DELETE FROM trade_scan_chunks WHERE report_id = ?").bind(id)
    ]);
    return { done: "Back in the queue: it's read again on a later sync run." };
  }
  if (!form2.reviewer) return { error: "Enter your name.", form: form2 };
  const report = { id, official_id: s.official_id };
  if (action === "reject") {
    if (!["agreed", "approved"].includes(s.status)) return { error: "Only a published transcription can be taken down.", form: form2 };
    if (!form2.reason) return { error: "Say what's wrong: it's kept with the report.", form: form2 };
    await db.batch([
      db.prepare("UPDATE trade_scans SET status = 'rejected', reviewed_by = ?, reviewer_email = ?, reviewed_at = datetime('now'), reject_reason = ? WHERE report_id = ?").bind(form2.reviewer, email || null, form2.reason, id),
      ...takeDownStatements(report).map((q) => db.prepare(q.sql).bind(...q.binds))
    ]);
    return { done: "Taken down. The report is a link again on public pages." };
  }
  if (action !== "approve") return { error: "Unknown action.", form: form2 };
  if (s.status !== "agreed") return { error: "Only a transcription published by AI can be confirmed.", form: form2 };
  if (rawForm.get("compared") !== "1") return { error: "Tick the box once you've compared every row with the scan.", form: form2 };
  const rows2 = json5(s.reading, []);
  if (!rows2.length) return { error: "This reading has no rows to publish.", form: form2 };
  const unread = json5(s.unread, []).map((u) => u.n).filter((n) => n != null);
  await db.batch([
    // Publish the rows again (unchanged if already public), then record who checked them (publishing clears the name).
    ...publishStatements({ id, official_id: s.official_id, chamber: s.chamber, state: s.state, filed_on: s.filed_on }, rows2).map((q) => db.prepare(q.sql).bind(...q.binds)),
    db.prepare("UPDATE trade_reports SET transcribed_by = ?, rows_total = ?, unread_rows = ? WHERE id = ?").bind(form2.reviewer, s.rows_total || rows2.length, JSON.stringify(unread), id),
    db.prepare("UPDATE trade_scans SET status = 'approved', reviewed_by = ?, reviewer_email = ?, reviewed_at = datetime('now') WHERE report_id = ?").bind(form2.reviewer, email || null, id)
  ]);
