    const st = stOfFips(fips);
    const place2 = st && await loadPlace(env, request, st.toLowerCase());
    const c = place2 && place2.counties.find((x) => x.fips === fips);
    if (c) topRows.push(`<a class="list-row link-row" href="${placeHref(st, c.slug)}"><div><div class="list-title">${esc(c.name)}, ${esc(place2.name)}</div><div class="list-meta">${n} ${n === 1 ? "person" : "people"} waiting</div></div><span class="row-end"><span class="chev" aria-hidden="true">\u203A</span></span></a>`);
  }
  const main = `
